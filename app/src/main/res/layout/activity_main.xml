<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#F7F9FC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏰ Despertador Professor Moreira"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#172033"
        android:gravity="center"
        android:layout_marginTop="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Curso de Contabilidade Professor Moreira"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="22dp"/>

    <TimePicker
        android:id="@+id/timePicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:timePickerMode="spinner"/>

    <Button
        android:id="@+id/activateButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="ATIVAR ALARME"
        android:textStyle="bold"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/cancelButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="DESATIVAR ALARME"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/testButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="TESTAR ALARME"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alarme desativado"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#172033"
        android:padding="18dp"
        android:layout_marginTop="18dp"/>
</LinearLayout>
